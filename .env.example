# Analytics: set these in Vercel (Project > Settings > Environment Variables).
# Scripts only load on the production deployment (VERCEL_ENV=production),
# never on preview deployments or in local dev.

# Google Analytics 4 measurement ID (e.g. G-XXXXXXX)
NEXT_PUBLIC_GA4_ID=

# Microsoft Clarity project ID
NEXT_PUBLIC_CLARITY_ID=

# Vercel Web Analytics needs no variable: enable it in the Vercel dashboard.

# Bing Webmaster API key, used by `npm run index:bing` (local only, never commit)
BING_API_KEY=
